# Example application.properties - DO NOT COMMIT real credentials
spring.application.name=TaskManager

# Use environment variables in production. Example placeholders below:
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/yourdb}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:db_user}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:db_pass}

spring.jpa.hibernate.ddl-auto=update
